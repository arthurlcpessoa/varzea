# Banco de dados (SQLite em desenvolvimento; para Postgres troque o provider no schema.prisma)
DATABASE_URL="file:./dev.db"
# Segredo para assinar os tokens JWT — troque em produção!
JWT_SECRET="troque-este-segredo"
PORT=3333
# URL pública do painel (usada nos links de recuperação de senha e convites)
APP_URL="http://localhost:5173"
# Provedores de integração: "console" (simulado) por enquanto
WHATSAPP_PROVIDER=console
PIX_PROVIDER=manual
